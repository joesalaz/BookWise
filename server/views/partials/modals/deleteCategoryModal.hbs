{{!-- Delete Category Modal --}}
<div id="deleteCategoryModal" 
     class="fixed inset-0 z-[60] items-center justify-center bg-black bg-opacity-40 hidden">
    <div class="bg-white rounded-lg shadow-lg w-[90%] max-w-md mx-auto mt-4 sm:mt-20 p-4 sm:p-8 relative">
        {{!-- Header --}}
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-2xl font-bold text-red-600">Delete Category</h3>
            <button id="closeDeleteCategoryModal" class="modal-close text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
        </div>

        {{!-- Confirmation Content --}}
        <div class="space-y-4">
            <div class="flex items-center space-x-3 mb-4">
                <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
                <div>
                    <p class="text-lg font-semibold text-gray-900">Are you sure?</p>
                    <p class="text-gray-600">This action cannot be undone.</p>
                </div>
            </div>

            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                <p class="text-red-800">
                    You're about to delete the category <strong id="deleteCategoryName"></strong>.
                </p>
                <p class="text-red-700 text-sm mt-1">
                    This category is empty and can be safely deleted.
                </p>
            </div>

            {{!-- Message Area --}}
            <div id="deleteCategoryMessage" class="hidden"></div>

            {{!-- Buttons --}}
            <div class="flex gap-3 pt-4">
                <button type="button" 
                        id="cancelDeleteCategory"
                        class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                    Cancel
                </button>
                <button type="button" 
                        id="confirmDeleteCategory"
                        class="flex-1 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                    Delete Category
                </button>
            </div>
        </div>
    </div>
</div>
