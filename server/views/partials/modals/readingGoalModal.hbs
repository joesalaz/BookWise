{{!-- Reading Goal Modal --}}
<div id="readingGoalModal" class="fixed inset-0 z-50 items-center justify-center bg-black bg-opacity-40 hidden">
    <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-auto mt-20 p-8 relative">
        {{!-- Header --}}
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-2xl font-bold text-gray-900">Set Reading Goal</h3>
            <button id="closeReadingGoalModal" class="modal-close text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
        </div>

        {{!-- Body --}}
        <form id="readingGoalForm" action="/reading-goals" method="POST" class="space-y-6">
            {{#if user.readingGoal}}
            <div class="bg-blue-50 text-blue-800 px-4 py-3 rounded-lg">
                Current Progress: {{user.booksCompleted}} of {{user.readingGoal}} books
            </div>
            {{/if}}

            <div>
                <label for="goalNumber" class="block text-sm font-semibold text-gray-700 mb-2">
                    How many books would you like to read this year?
                </label>
                <input type="number" 
                       id="goalNumber" 
                       name="readingGoal" 
                       class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" 
                       min="1" 
                       max="1000"
                       value="{{user.readingGoal}}"
                       required>
                <p class="mt-2 text-sm text-gray-500">Set a realistic goal that motivates you!</p>
            </div>

            <div class="flex gap-4 mt-6">
                <button type="button" 
                        class="modal-close flex-1 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition">
                    Cancel
                </button>
                <button type="submit" 
                        class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                    Save Goal
                </button>
            </div>
        </form>
    </div>
</div>
